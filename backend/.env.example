# 教学系统环境变量配置
# 复制此文件为 .env 并修改配置

# ========== 基础配置 ==========
PROJECT_NAME=TeachingPlatform
API_V1_STR=/api/v1
SECRET_KEY=change-this-secret-key-in-production-abcdefghijk
ACCESS_TOKEN_EXPIRE_MINUTES=60
SCHOOL_ID=default-school
SCHOOL_NAME=Default School
FEDERATION_SSO_TTL_SECONDS=60
FEDERATION_CONSUMER_SECRET=change-me-for-federation

# ========== 数据库配置 ==========
# Docker Compose 环境使用服务名，单独运行使用 localhost
DATABASE_URL=mysql+pymysql://root:teaching2024@mysql:3306/teaching_platform

# ========== Redis 配置 ==========
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== ComfyUI 队列配置 ==========
# 开发环境并发数
COMFY_MAX_CONCURRENT=2
# 生产环境并发数
COMFY_MAX_CONCURRENT_PROD=10

# ========== GPU 服务器配置 ==========
# HTTP 请求地址（转发工作流）
# 使用 DDNS 域名，自动解析到动态 IP，无需手动更新
COMFY_GPU_HOST=edu.yanzhiedu.cn

# SSH 配置（远程启动/停止 ComfyUI）
COMFY_GPU_SSH_PORT=22
COMFY_GPU_USER=yzcube
COMFY_GPU_PASSWORD=Yanzhi2025.
COMFY_BASE_PATH=/home/yzcube/cube/comfyui-test/ComfyUI-test
COMFY_CONDA_INIT_SCRIPT=/home/yzcube/anaconda3/etc/profile.d/conda.sh
COMFY_CONDA_ENV_NAME=comfyui

# ========== MinIO 头像上传试点 ==========
# 仅当 MINIO_AVATAR_ENABLED=true 且上传 type=avatars 时启用
MINIO_AVATAR_ENABLED=false
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_DOMAIN=http://127.0.0.1:9000/teaching
MINIO_BUCKET=teaching
MINIO_ACCESS_KEY=minioadmin
MINIO_ACCESS_SECRET=minioadmin
MINIO_USE_SSL=false
MINIO_AVATAR_PREFIX=avatars
MINIO_COMMON_ENABLED=false
MINIO_COMMON_PREFIX=common
MINIO_HOMEWORK_ENABLED=false
MINIO_HOMEWORK_PREFIX=homework
